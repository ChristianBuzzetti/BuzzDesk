<Window x:Class="BuzzDesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BuzzDesk" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="BuzzDesk" Width="1360" Height="860" MinWidth="860" MinHeight="560" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- DBMON shell (same as BuzzPrint): topbar (logo, wordmark, status dot, menus, search) with the neon edge at its
         foot, then the subbar of actions for the current view. Boberto's 16:9 scene owns the right side of the band. -->
    <Grid DockPanel.Dock="Top" Background="{DynamicResource Header}" Panel.ZIndex="1">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="BobertoColumn" Width="300"/></Grid.ColumnDefinitions>
      <DockPanel x:Name="HeaderLeft">
        <Border x:Name="HeaderBar" DockPanel.Dock="Top" Background="{DynamicResource Header}" BorderBrush="{DynamicResource TopbarRule}" BorderThickness="0,0,0,1" Padding="30,10,16,6">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <local:BobertoMark x:Name="BrandMark" Tile="{DynamicResource Accent}" Width="44" Height="44" Margin="0,-6,14,-6" VerticalAlignment="Center" ToolTip="Boberto"/>
              <StackPanel x:Name="Wordmark" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" ToolTip="BuzzDesk" MouseLeftButtonUp="WordmarkClick"/>
              <Grid Width="12" Height="12" Margin="8,2,0,0" VerticalAlignment="Center"><Ellipse Width="12" Height="12" Fill="{DynamicResource OkGlow}"/><Ellipse x:Name="BrandDot" Width="6" Height="6" Fill="{DynamicResource Ok}"/></Grid>
              <Menu x:Name="MainMenu" Padding="16,0,0,0" VerticalAlignment="Center" FontSize="{DynamicResource ShellFontSize}">
                <MenuItem Header="{local:T 'Archivo'}" Tag="&#xE8A5;">
                  <MenuItem x:Name="MenuQuickCapture" Header="{local:T 'Captura rápida'}" Click="QuickCaptureClick"/>
                  <Separator/>
                  <MenuItem Header="{local:T 'Hacer una copia de seguridad ahora'}" Click="BackupNowClick"/>
                  <MenuItem Header="{local:T 'Copia en la nube…'}" Click="CloudClick"/>
                  <MenuItem Header="{local:T 'Subir copia a la nube ahora'}" Click="CloudNowClick"/>
                  <MenuItem Header="{local:T 'Restaurar desde una copia…'}" Click="RestoreClick"/>
                  <MenuItem Header="{local:T 'Abrir la carpeta de datos'}" Click="DataFolderClick"/>
                  <Separator/>
                  <MenuItem Header="{local:T 'Salir'}" Click="ExitClick"/>
                </MenuItem>
                <MenuItem Header="{local:T 'Ir a'}" Tag="&#xE8AB;">
                  <MenuItem Header="{local:T 'Hoy'}" InputGestureText="Ctrl+1" Click="GoTodayClick"/>
                  <MenuItem Header="{local:T 'Pendientes'}" InputGestureText="Ctrl+2" Click="GoTasksClick"/>
                  <MenuItem Header="{local:T 'Temas'}" InputGestureText="Ctrl+3" Click="GoTopicsClick"/>
                  <MenuItem Header="{local:T 'Enlaces'}" InputGestureText="Ctrl+4" Click="GoLinksClick"/>
                  <Separator/>
                  <MenuItem Header="{local:T 'Buscar en todo'}" InputGestureText="Ctrl+F" Click="FocusSearchClick"/>
                </MenuItem>
                <MenuItem Header="{local:T 'Vista'}" Tag="&#xE890;">
                  <MenuItem Header="{local:T 'Personalizar…'}" Click="PersonalizeClick"/>
                  <Separator/>
                  <MenuItem x:Name="ShowBobertoMenu" Header="Boberto" IsCheckable="True" IsChecked="True" Click="BobertoToggleClick"/>
                  <Separator/>
                  <MenuItem Header="{local:T 'Idioma'}">
                    <MenuItem x:Name="LangEnMenu" Header="English" IsCheckable="True" Click="LangEnClick"/>
                    <MenuItem x:Name="LangEsMenu" Header="Español" IsCheckable="True" Click="LangEsClick"/>
                  </MenuItem>
                  <MenuItem x:Name="ZoneMenu" Header="{local:T 'Zona horaria'}" SubmenuOpened="ZoneMenuOpened"><MenuItem Header="…"/></MenuItem>
                  <MenuItem x:Name="StartupMenu" Header="{local:T 'Iniciar con Windows'}" IsCheckable="True" Click="StartupClick"/>
                </MenuItem>
                <MenuItem x:Name="MenuAi" Header="{local:T 'IA'}" Tag="&#xEA80;"><MenuItem Header="{local:T 'Configurar IA…'}" Click="AiSettingsClick"/></MenuItem>
                <MenuItem Header="{local:T 'Ayuda'}" Tag="&#xE897;"><MenuItem Header="{local:T 'Guía de BuzzDesk'}" InputGestureText="F1" Click="GuideClick"/><Separator/><MenuItem Header="{local:T 'Revisar componentes…'}" Click="ComponentsClick"/><MenuItem Header="{local:T 'Acerca de BuzzDesk'}" Click="AboutClick"/></MenuItem>
              </Menu>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="SearchBox" Width="340" Height="38" BorderThickness="1" BorderBrush="{DynamicResource FaintBorder}" Background="{DynamicResource Surface}" CornerRadius="{DynamicResource ControlRadius}" Padding="10,0,6,0">
                <DockPanel>
                  <Border DockPanel.Dock="Right" BorderThickness="1" BorderBrush="{DynamicResource FaintBorder}" Padding="5,0" VerticalAlignment="Center" CornerRadius="{DynamicResource ControlRadius}"><TextBlock Text="Ctrl F" FontFamily="{DynamicResource MonoFont}" FontSize="11.5" Foreground="{DynamicResource Muted}"/></Border>
                  <TextBlock DockPanel.Dock="Left" Style="{StaticResource GlyphText}" Text="&#xE721;" Foreground="{DynamicResource Muted}"/>
                  <Grid>
                    <TextBox x:Name="Search" BorderThickness="0" Background="Transparent" Padding="0,8" FontSize="{DynamicResource ShellFontSize}" TextChanged="SearchChanged" ToolTip="{local:T 'Buscar en pendientes, temas, notas y enlaces'}"/>
                    <TextBlock Text="{local:T 'Buscar en todo'}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Foreground="{DynamicResource Muted}" FontSize="{DynamicResource ShellFontSize}" VerticalAlignment="Center" Margin="2,0,0,0">
                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DockPanel>
              </Border>
            </StackPanel>
          </Grid>
        </Border>
        <Grid DockPanel.Dock="Top" Height="2" ClipToBounds="True"><Rectangle Fill="{DynamicResource EdgeBar}" Opacity="0.75"/><Rectangle x:Name="EdgeSweep"/></Grid>
        <Border BorderBrush="{DynamicResource StrongBorder}" BorderThickness="0,0,0,1" Background="{DynamicResource SubbarHairlines}">
          <Border Padding="{DynamicResource ToolbarPadding}">
            <DockPanel>
              <Button DockPanel.Dock="Left" x:Name="QuickCaptureButton" VerticalAlignment="Center" Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}" BorderBrush="{DynamicResource Accent}" Click="QuickCaptureClick" Margin="0,0,8,0" ToolTip="{local:T 'Crear un pendiente, una nota o un recordatorio en dos segundos'}"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource GlyphText}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{local:T 'Captura rápida'}" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CaptureKeyHint" Text="Ctrl Alt Space" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" Opacity="0.75" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
              <Border DockPanel.Dock="Left" Width="1" Height="22" Background="{DynamicResource FaintBorder}" Margin="2,0,10,0"/>
              <!-- Each view puts its own actions here. -->
              <StackPanel x:Name="ViewToolbar" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>
        </Border>
      </DockPanel>
      <Canvas Grid.Column="1" ClipToBounds="False">
        <Border x:Name="BobertoPanel" Background="{DynamicResource Header}" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,1,1">
          <ContentControl x:Name="BobertoHost" Focusable="False"/>
        </Border>
      </Canvas>
    </Grid>
    <!-- .bzp-footer colophon: accent double rule above, mono status line. -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Header}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top"><Border Height="1" Background="{DynamicResource AccentWeak}"/><Border Height="1" Margin="0,2,0,0" Background="{DynamicResource AccentRule}"/><Border Height="1" Margin="0,1,0,0" Background="{DynamicResource TopbarGlow}"/></StackPanel>
        <Grid Margin="16,6,14,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DockPanel>
            <Button x:Name="StatusAction" DockPanel.Dock="Right" Style="{StaticResource StatusSegment}" Visibility="Collapsed" Click="StatusActionClick" HorizontalAlignment="Left"><TextBlock x:Name="StatusActionText" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Button>
            <TextBlock x:Name="StatusText" Text="{local:T 'Listo'}" Foreground="{DynamicResource Muted}" FontFamily="{DynamicResource MonoFont}" FontSize="{DynamicResource SmallFontSize}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
          </DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource StatusSegment}" Click="QuickCaptureClick" ToolTip="{local:T 'Captura rápida'}"><StackPanel Orientation="Horizontal"><TextBlock x:Name="StatusCaptureKey" Text="Ctrl+Alt+Space" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,6,0"/><TextBlock Text="{local:T 'capturar'}" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
            <Border BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="8,2,4,2"/>
            <Button Style="{StaticResource StatusSegment}" Click="ZoneStatusClick" ToolTip="{local:T 'Zona horaria'}"><StackPanel Orientation="Horizontal"><TextBlock Text="TZ" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="ZoneStatus" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/></StackPanel></Button>
            <Border BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="8,2,4,2"/>
            <Button Style="{StaticResource StatusSegment}" Click="CloudClick" ToolTip="{local:T 'Copia en la nube'}"><StackPanel Orientation="Horizontal"><TextBlock Text="☁" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="CloudStatus" Foreground="{DynamicResource Ink}" FontWeight="SemiBold"/></StackPanel></Button>
            <Border BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1,0,0,0" Margin="8,2,4,2"/>
            <Button Style="{StaticResource StatusSegment}" Click="DataFolderClick" ToolTip="{local:T 'Base de datos y copias de seguridad'}"><StackPanel Orientation="Horizontal"><TextBlock Text="DB" Foreground="{DynamicResource Muted}" Margin="0,0,6,0"/><TextBlock x:Name="DbStatus" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></StackPanel></Button>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Grid x:Name="WorkArea" Margin="14,12,14,12">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <!-- DBMON sidebar (.dbm-side): the four views, then areas and projects; settings at the foot. -->
      <Border x:Name="Sidebar" Margin="0,0,12,0" Background="{DynamicResource Header}" BorderBrush="{DynamicResource FaintBorder}" BorderThickness="1" CornerRadius="{DynamicResource PanelRadius}" Padding="8,2,8,8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Border Height="1" Background="{DynamicResource FaintBorder}" Margin="6,6,6,6"/>
            <Button Style="{StaticResource NavAction}" Click="PersonalizeClick"><DockPanel><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;"/><TextBlock Text="{local:T 'Personalizar'}"/></DockPanel></Button>
            <Button Style="{StaticResource NavAction}" Click="GuideClick" ToolTip="{local:T 'Todo lo que puede hacer BuzzDesk, paso a paso · F1'}"><DockPanel><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE82D;"/><TextBlock Text="{local:T 'Guía'}"/></DockPanel></Button>
            <Button x:Name="NavAiStatus" Style="{StaticResource NavAction}" Click="AiSettingsClick"><DockPanel><Ellipse x:Name="NavAiDot" DockPanel.Dock="Right" Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Muted}"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xEA80;"/><TextBlock x:Name="NavAiText" Text="IA" TextTrimming="CharacterEllipsis"/></DockPanel></Button>
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Style="{StaticResource NavLabel}" Text="{local:T 'ESCRITORIO'}"/>
              <RadioButton x:Name="NavToday" Style="{StaticResource NavItem}" GroupName="Nav" Tag="today" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavTodayCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE706;"/><TextBlock Text="{local:T 'Hoy'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavTasks" Style="{StaticResource NavItem}" GroupName="Nav" Tag="tasks" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavTasksCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE73A;"/><TextBlock Text="{local:T 'Pendientes'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavTopics" Style="{StaticResource NavItem}" GroupName="Nav" Tag="topics" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavTopicsCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8BD;"/><TextBlock Text="{local:T 'Temas'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavLinks" Style="{StaticResource NavItem}" GroupName="Nav" Tag="links" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavLinksCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE71B;"/><TextBlock Text="{local:T 'Enlaces'}"/></DockPanel></RadioButton>
              <TextBlock Style="{StaticResource NavLabel}" Text="{local:T 'PERSONAL'}"/>
              <RadioButton x:Name="NavHabits" Style="{StaticResource NavItem}" GroupName="Nav" Tag="habits" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavHabitsCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE9D9;"/><TextBlock Text="{local:T 'Hábitos'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavLists" Style="{StaticResource NavItem}" GroupName="Nav" Tag="lists" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavListsCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE762;"/><TextBlock Text="{local:T 'Listas'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavBills" Style="{StaticResource NavItem}" GroupName="Nav" Tag="bills" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavBillsCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8C7;"/><TextBlock Text="{local:T 'Pagos y vencimientos'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavDates" Style="{StaticResource NavItem}" GroupName="Nav" Tag="dates" Checked="NavChecked"><DockPanel><TextBlock x:Name="NavDatesCount" Style="{StaticResource NavCount}" DockPanel.Dock="Right"/><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE7BF;"/><TextBlock Text="{local:T 'Fechas importantes'}"/></DockPanel></RadioButton>
              <RadioButton x:Name="NavSearch" Style="{StaticResource NavItem}" GroupName="Nav" Tag="search" Checked="NavChecked" Visibility="Collapsed"><DockPanel><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE721;"/><TextBlock Text="{local:T 'Resultados'}"/></DockPanel></RadioButton>
              <!-- Areas and projects (filled by the Tasks view once the database exists). -->
              <StackPanel x:Name="NavSectionsGroup"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <ContentControl x:Name="ViewHost" Grid.Column="1" Focusable="False"/>
    </Grid>
  </DockPanel>
</Window>
